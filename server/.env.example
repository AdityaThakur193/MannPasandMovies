PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mannpasandmovies?retryWrites=true&w=majority
# IMPORTANT: JWT_SECRET must be at least 32 characters for security
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_32_CHAR_SECRET_KEY_GENERATED_RANDOMLY
JWT_EXPIRATION=30d
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
NODE_ENV=development

# Google OAuth Configuration
# Get these credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing one
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URIs:
#    - Development: http://localhost:5000/api/auth/google/callback
#    - Production: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend URL (for OAuth redirects after authentication)
# Development: http://localhost:5173 or http://localhost:3001
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Production: Your deployed backend URL (only needed in production)
# Example: https://api.yourdomain.com or https://yourdomain.com
# SERVER_URL=https://yourdomain.com
