{
  "name": "mannpasandmovies-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/.bin/vite';try{fs.chmodSync(p,0o755);}catch(err){if(err.code!=='ENOENT')console.warn(err.message);}\""
  },
