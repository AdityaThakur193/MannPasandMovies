    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.0.18",
    "axios-mock-adapter": "^2.1.0",
    "happy-dom": "^20.3.9",
    "jsdom": "^27.4.0",
    "vite": "^5.0.8",
    "vitest": "^4.0.18"
  }
