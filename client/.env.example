# API URL of the Express backend (development default: http://localhost:5001/api)
VITE_API_URL=http://localhost:5001/api

# TMDB API Configuration (can be securely proxied via server, or called directly)
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500
